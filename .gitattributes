# 统一行尾符：仓库内一律存储 LF，避免跨平台协作时产生整文件 diff。
# Windows 上的编辑器如需 CRLF，由 git 在检出时按需转换（core.autocrlf）。

# 默认：让 git 自动识别文本文件并在入库时规范化为 LF
* text=auto eol=lf

# 明确声明主要文本类型，避免自动识别误判
*.py      text eol=lf
*.pyi     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.example text eol=lf
*.lock    text eol=lf
Dockerfile        text eol=lf
.dockerignore     text eol=lf
.gitignore        text eol=lf
.gitattributes    text eol=lf
LICENSE           text eol=lf

# Shell 脚本必须是 LF，否则在 Linux 容器内无法执行
*.sh      text eol=lf

# Windows 批处理保持 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制文件不做任何行尾转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.whl     binary
*.so      binary
*.dll     binary
*.pyd     binary
