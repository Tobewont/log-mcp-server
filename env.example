# log-mcp-server 环境变量示例。
# 复制为 `.env` 后按需修改。注释里给出的是默认值。

# ---------------------------------------------------------------------------
# MCP 传输方式
# ---------------------------------------------------------------------------
# 通过 MCP_TRANSPORT 显式选择传输方式，不会自动推断。
# 可选值："stdio" | "sse" | "streamable-http"
# MCP_TRANSPORT=stdio
# 容器内/对外暴露时改为 0.0.0.0
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# streamable-http 传输挂载的 URL 路径前缀（必须以 / 开头）。
# SSE / stdio 不受此配置影响。抽出来便于和其它 MCP 服务统一规划
# 反向代理 / Ingress 路径。
# MCP_PATH=/mcp

# ---------------------------------------------------------------------------
# 后端选择
# ---------------------------------------------------------------------------
# 目前仅支持 "loki"。
# LOG_BACKEND=loki

# ---------------------------------------------------------------------------
# Loki 后端
# ---------------------------------------------------------------------------
LOKI_ADDR=http://localhost:3100
# 多 Loki 实例（Thanos 风格扇出查询）：用 | 分隔多个 URL。
# LOKI_ADDR=http://loki-bj:3100|http://loki-sh:3100|http://loki-sg:3100

# 单租户部署使用 "fake"。
# 多租户：用 | 分隔，例如 "team-a|team-b|team-c"。
LOKI_TENANTS=fake

# ---------------------------------------------------------------------------
# 客户端租户范围（日志查询/下载工具必填）
# ---------------------------------------------------------------------------
# 日志查询 / 下载工具（query_logs / get_labels / get_label_values /
# download_logs）要求 MCP 客户端先声明可见租户子集，否则直接拒绝执行。
# 两种声明方式：
#
#   * stdio 模式：在 mcp.json 的 env 块中设置 LOKI_CLIENT_TENANTS
#     （LOKI_TENANTS 的子集，逗号分隔）。
#   * streamable-http / sse 模式：每个 MCP 客户端请求都必须携带
#     `X-Allowed-Tenants` HTTP 请求头（逗号分隔）。该请求头优先于
#     LOKI_CLIENT_TENANTS 环境变量。
#
# health_check 不受此限制，未声明范围时仍可调用，便于排查"为什么查不到"。
# 任何超出允许范围的租户都会被服务端直接拒绝。
# 这是纵深防御，不是身份认证。
#
# 性能提示：只列出实际需要的租户。未显式传 tenant= 时工具会并发查询
# 这里列出的所有租户，配的越多查询越慢、噪声越大、结果越不精准。
# LOKI_CLIENT_TENANTS=team-a,team-b

# ---------------------------------------------------------------------------
# 日志下载（download_logs 工具）
# ---------------------------------------------------------------------------
# stdio 模式：这就是用户本机文件系统（server 与 client 同进程），
#   工具返回的绝对路径直接可读。
# streamable-http / sse 模式：这是服务端文件系统（例如 pod 的 emptyDir），
#   服务端额外挂载 /<MCP前缀>/download/<token> 路由对外提供下载。
# LOG_DOWNLOAD_DIR=./logs/downloads
#
# 生成的文件（及对应的下载令牌）多久后被清理。仅 HTTP 模式生效。
# LOG_DOWNLOAD_TTL_SECONDS=3600
#
# HTTP 模式下用于渲染下载链接的可选 base URL。在反向代理改写 Host
# 的场景下显式设置；不设时服务端会根据请求的 scheme + Host 自动推断
# （并优先读取 X-Forwarded-Proto / X-Forwarded-Host）。
# LOG_DOWNLOAD_BASE_URL=https://logs-mcp.example.com

# 鉴权（最多选一种）。
# LOKI_USERNAME=your-username
# LOKI_PASSWORD=your-password
# LOKI_BEARER_TOKEN=your-bearer-token
# LOKI_BEARER_TOKEN_FILE=/path/to/token/file

# TLS
# LOKI_CA_FILE=/path/to/ca.crt
# LOKI_CERT_FILE=/path/to/client.crt
# LOKI_KEY_FILE=/path/to/client.key
# LOKI_TLS_SKIP_VERIFY=false

# HTTP 超时（秒）
# LOKI_CONNECT_TIMEOUT=10.0
# LOKI_READ_TIMEOUT=15.0
# LOKI_WRITE_TIMEOUT=10.0
# LOKI_POOL_TIMEOUT=10.0

# ---------------------------------------------------------------------------
# 健康检查缓存（仅多 Loki 集群时生效）
# ---------------------------------------------------------------------------
# 不健康的集群在数据查询时会被自动跳过。
# 后台刷新间隔（秒）
# HEALTH_CHECK_INTERVAL=300
# 单个集群健康探测超时（秒）
# HEALTH_CHECK_TIMEOUT=5

# ---------------------------------------------------------------------------
# 通用查询 / 时间相关参数（适用于所有后端）
# ---------------------------------------------------------------------------
# LOG_DEFAULT_LIMIT=100
# LOG_MAX_LIMIT=5000
# LOG_DEFAULT_TIME_RANGE_MINUTES=30
# LOG_TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------------------
# 返回体瘦身（query_logs 输出详略程度）
# ---------------------------------------------------------------------------
# query_logs 默认详略档位：compact / normal / full。
#   * compact —— 只输出日志正文，一行一条，无 Entry 头 / Time / Labels；
#     token 开销最低，常规排查首选（默认）。
#   * normal  —— 正文 + 短格式时间 + 差异标签，公共标签在头部只输出一次。
#   * full    —— 完整格式（Entry 头 + 纳秒时间 + 全量标签）。
# 单次调用可用 query_logs 的 verbosity 参数覆盖本默认值。
# LOG_DEFAULT_VERBOSITY=compact
#
# compact / normal 模式下单条日志行的最大字符数，超过则截断并追加提示
# （full 模式不截断）。避免个别超长行撑爆返回体。
# LOG_MAX_LINE_CHARS=2000
#
# compact 模式下是否折叠连续的同模板重复行（≥3 条折叠成一条并标 ×N）。
# LOG_FOLD_REPEATS=true
#
# compact / normal 模式下是否剥离日志正文中的 ANSI 颜色码。级别文字本来
# 就在正文里，因此是零信息损失优化，默认开启；full 模式恒不剥离。
# LOG_STRIP_ANSI=true
#
# compact 模式下重复行折叠的作用域：
#   * adjacent —— 只折叠连续同模板行（默认），不打乱时序，语义最安全。
#   * global   —— 全窗口按模板聚类（不要求相邻），省 token 最多，但属于
#     有损概览：同模板行会汇总到首次出现的位置。
# 两种作用域都不会折叠 WARNING / ERROR / CRITICAL 行。
# LOG_FOLD_SCOPE=adjacent
#
# query_logs 未显式传 exclude_loggers 时默认排除的 logger 名（逗号分隔）。
# 库级 trace / access 日志（httpcore._trace、
# uvicorn.protocols.http.h11_impl 等）噪音极大，但"隐藏内容"必须由用户
# 主动选择，因此默认是**空列表 = 开箱不排除任何 logger**。
# 支持 fnmatch 通配（httpcore.* 前缀匹配、也可写精确 logger 名）。
# 命中黑名单但级别为 WARNING / ERROR / CRITICAL 的行永不被排除；解析不出
# logger 的行也一律保留。full 模式不生效。
# LOG_DEFAULT_EXCLUDE_LOGGERS=httpcore.*,uvicorn.protocols.http.h11_impl
#
# normal 模式下是否去掉正文开头与行首时间戳重复的那个时间戳。
# **仅 normal 生效**——compact 行首没有时间，正文里的时间戳是唯一
# 时间来源，因此恒不去重；full 同样不处理。只在时间确实吻合（同一秒，允许
# 毫秒差异）时才去掉，不吻合就保持原样。
# LOG_DEDUP_TIMESTAMP=false
#
# ---- A 档「零信息损失」正文瘦身（三项默认全开）----------------------------
# 三项都不丢排查信息：时分秒 / 级别 / 模块名 / 行号 / 业务 ID / HTTP 状态码 /
# 异常关键字 / 堆栈缩进全部完好，被提取或省略的内容都会在返回体头部标注一次，
# 用户可自行核对与还原。verbosity=full 是绝对逃生舱，三项一律不生效。
# 每项在 query_logs 都有同名参数，可单独关闭。
#
# 是否把所有输出行的最长公共前缀（≥8 字符时）提到头部只输出一次。
# 同一批日志常共享时间 / 级别 / 模块的固定前缀。compact / normal 均生效；
# 只有 1 行、前缀太短、或前缀会把某行完全吃空时自动放弃上提。
# LOG_HOIST_COMMON_PREFIX=true
#
# 是否把行内连续 ≥2 个**空格**压成 1 个（loguru 级别对齐填充是主要来源）。
# 只处理空格，tab 与换行不碰；**行首缩进原样保留**——堆栈跟踪与
# YAML / JSON 片段靠缩进表达结构。
# compact / normal 均生效。
# LOG_COLLAPSE_WHITESPACE=true
#
# 是否省略正文开头重复的 "YYYY-MM-DD " 日期，**仅 compact 生效**。HH:MM:SS(.mmm) 一定保留——compact 行首没有时间，正文时间戳是唯一时间
# 来源。跨天自动整批禁用：批次里出现 ≥2 个不同日期就完全保持原样。
# LOG_HOIST_COMMON_DATE=true
#
# download_logs 未显式传 fmt 时的默认下载格式：txt / jsonl / csv。
# 默认 txt（已瘦身：公共标签在文件头输出一次、行内只留差异标签），
# 体积最小；需要结构化后处理（jq / 入库）时在调用处显式传 jsonl / csv。
# LOG_DEFAULT_DOWNLOAD_FORMAT=txt

# ---------------------------------------------------------------------------
# 服务自身的日志级别
# ---------------------------------------------------------------------------
# 可选值：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 仅 docker-compose 用到
# ---------------------------------------------------------------------------
# GRAFANA_PASSWORD=admin
